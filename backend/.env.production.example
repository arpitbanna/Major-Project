# ============================================================================
# COALSAFE BACKEND — PRODUCTION ENVIRONMENT VARIABLES
# Recommended host: Render (Web Service) or Railway / Fly.io
# ============================================================================

# Injected automatically by Render/Railway (typically 10000 or custom)
PORT=5000

# Set to production to disable verbose dev logs
NODE_ENV=production

# Production Frontend Origin (e.g. https://coalsafe-colliery.vercel.app)
CLIENT_URL=https://your-frontend.vercel.app

# Live Supabase Production Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Secret Key (KEEP PRIVATE — do not expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase Anon Public Key (used as fallback)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Shared Secret Key for External ERP Integration (used with x-api-key header)
ERP_API_KEY=your-strong-production-erp-secret-key-2026
