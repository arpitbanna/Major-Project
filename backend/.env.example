# Port where the Express API server listens
PORT=5000

# Environment mode: development | production
NODE_ENV=development

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (secret key with admin access - KEEP SECURE, NEVER EXPOSE TO FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase Anon Key (public API key used as fallback)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Frontend origin allowed to make cross-origin requests to this backend
CLIENT_URL=http://localhost:5173

# Shared secret key for secure read-only ERP integration export endpoints
ERP_API_KEY=coalsafe-erp-api-key-change-me
