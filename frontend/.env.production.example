# Live Supabase Production Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Safe for client browsers)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Base API URL (/api routes are proxied via vercel.json rewrites)
VITE_API_URL=/api
